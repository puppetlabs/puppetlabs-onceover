#!/usr/bin/env ruby

require 'puppetlabs-onceover/cli'
require 'colored'

begin
  PuppetlabsOnceover::CLI.command.run(ARGV)
rescue Interrupt
  warn "Aborted!".red
  exit(1)
rescue SystemExit => e
  exit(e.status)
rescue Exception => e
  warn "\nError while running: #{e.inspect}".red
  warn e.backtrace.join("\n").red if ARGV.include? '--trace'
  exit(1)
end
